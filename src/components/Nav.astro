---
const navLinks = [
  { href: '#experience', label: 'Experience' },
  { href: '#projects',   label: 'Projects' },
  { href: '#contact',    label: 'Contact' },
];
---

<nav class="nav">
  <div class="nav__inner">
    <a href="/" class="nav__logo">Ziyad Patel</a>
    <ul class="nav__links">
      {navLinks.map(({ href, label }) => (
        <li><a href={href}>{label}</a></li>
      ))}
    </ul>
  </div>
</nav>
