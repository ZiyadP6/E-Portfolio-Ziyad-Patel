<section id="experience">
  <div class="container">
    <p class="section__label">Experience</p>

    <ul class="experience__list">
      <li class="experience__item">
        <span class="experience__date">Apr 2026 – Present</span>
        <div>
          <p class="experience__role">
            Junior Developer
            <span class="badge">Current</span>
          </p>
          <p class="experience__company">Mountain Warehouse · Web Team</p>
          <ul class="experience__notes">
            <li>Working on the company's Next.js storefront, Vercel infrastructure, BigCommerce commerce layer, Contentful CMS, and Algolia search</li>
            <li>Part of the team that migrated the old site to the new modern stack</li>
          </ul>
        </div>
      </li>

      <li class="experience__item">
        <span class="experience__date">Sep 2024 – Apr 2026</span>
        <div>
          <p class="experience__role">Software Developer Apprentice <span class="badge" style="background:#dcfce7;color:#166534;">Distinction</span></p>
          <p class="experience__company">Mountain Warehouse · FinDev & Customer Service Dev Teams</p>
          <ul class="experience__notes">
            <li>Level 4 Software Developer Apprenticeship via QA — awarded Distinction</li>
            <li>FinDev: React frontends, .NET/C# backends, SQL database work, Playwright automation suite for Supplier Portal</li>
            <li>Customer Service Dev: built the full Gift Card Refund feature — React microfrontend, .NET backend, OMS integration</li>
          </ul>
        </div>
      </li>

      <li class="experience__item">
        <span class="experience__date">Before 2024</span>
        <div>
          <p class="experience__role">Customer Care Advisor</p>
          <p class="experience__company">Mountain Warehouse</p>
          <ul class="experience__notes">
            <li>Customer-facing support role before moving into the technical apprenticeship</li>
          </ul>
        </div>
      </li>
    </ul>

    <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border);">
      <p class="section__label" style="margin-bottom: 1.5rem;">Education & Credentials</p>
      <ul class="experience__list">
        <li class="experience__item">
          <span class="experience__date">2026 – Present</span>
          <div>
            <p class="experience__role">Google Data Analytics Certificate</p>
            <p class="experience__company">Coursera · In Progress</p>
          </div>
        </li>
        <li class="experience__item">
          <span class="experience__date">2024 – Present</span>
          <div>
            <p class="experience__role">RITTech MBCS</p>
            <p class="experience__company">BCS, The Chartered Institute for IT</p>
            <ul class="experience__notes">
              <li>Registered IT Technician status awarded following apprenticeship completion</li>
            </ul>
          </div>
        </li>
        <li class="experience__item">
          <span class="experience__date">2023 – 2024</span>
          <div>
            <p class="experience__role">Computing & IT and Business</p>
            <p class="experience__company">The Open University</p>
            <ul class="experience__notes">
              <li>One year of part-time undergraduate study completed alongside work</li>
            </ul>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>
